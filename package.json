{
  "name": "dsh-token-bar",
  "version": "0.1.0",
  "type": "module",
  "description": "A per-turn token usage strip for DeepSeek Harness: a segmented bar plus a written legend under every reply, showing this turn's uncached input / cache read / output split.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "client-plugin",
    "token",
    "usage",
    "cache",
    "web"
  ],
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test-helpers.mjs && node test-served-bundle.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/REPLACE_WITH_YOUR_USERNAME/dsh-token-bar.git"
  },
  "bugs": {
    "url": "https://github.com/REPLACE_WITH_YOUR_USERNAME/dsh-token-bar/issues"
  },
  "homepage": "https://github.com/REPLACE_WITH_YOUR_USERNAME/dsh-token-bar#readme"
}
